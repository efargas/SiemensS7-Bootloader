<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:S7_Csharp_Utility.Controls"
        x:Class="S7_Csharp_Utility.TestHexViewerWindow"
        Title="Test Custom Hex Viewer"
        Width="1200"
        Height="800"
        Background="#1A1A1A">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#2D3748" BorderThickness="0,0,0,1" BorderBrush="#4A5568" Padding="15,10">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="📁 Load File" Command="{Binding LoadFirstFileCommand}" 
                        IsEnabled="{Binding !IsLoading}" 
                        Background="#4C51BF" Foreground="White" Padding="12,6" CornerRadius="4"/>
                
                <TextBlock Text="{Binding StatusText}" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Custom Hex Viewer Control -->
        <controls:HexViewerControl Grid.Row="1" 
                                   HexRows="{Binding HexRows1}"
                                   Margin="15"/>
    </Grid>
</Window>