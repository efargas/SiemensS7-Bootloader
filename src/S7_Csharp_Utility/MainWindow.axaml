<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:S7_Csharp_Utility.ViewModels"
        xmlns:views="using:S7_Csharp_Utility.Views"
        x:Class="S7_Csharp_Utility.MainWindow"
        Title="S7 Bootloader Utility (Cross-Platform)"
        Width="900" Height="600"
        MinWidth="700" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Save Configuration" Command="{Binding SaveConfigurationCommand}" />
                <MenuItem Header="Load Configuration" Command="{Binding LoadConfigurationCommand}" />
                <Separator/>
                <MenuItem Header="Exit" Name="MenuExit" />
            </MenuItem>
            <MenuItem Header="Preferences" />
            <MenuItem Header="Tools">
                <MenuItem Header="Profile Management" Name="MenuProfileManagement" />
                <MenuItem Header="Firmware Unpacker" Name="MenuFirmwareUnpacker" />
                <MenuItem Header="Hex Viewer" Name="MenuHexViewer" />
            </MenuItem>
            <MenuItem Header="Help" />
        </Menu>
        
        <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*">
            <Expander x:Name="ConfigExpander" Header="Configuration" IsExpanded="True" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.Row="0">
                <TabControl HorizontalAlignment="Stretch">
                    <TabItem Header="Connection Parameters">
                        <Grid ColumnDefinitions="2*,2*" HorizontalAlignment="Stretch">
                            <views:PlcConnectionView Grid.Column="0" DataContext="{Binding PlcConnectionViewModel}" Margin="0,0,8,0" />
                            <views:ModbusPowerSupplyView Grid.Column="1" DataContext="{Binding ModbusPowerSupplyViewModel}" Margin="8,0,0,0" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Folders &amp; Paths">
                        <Grid RowDefinitions="Auto,*" HorizontalAlignment="Stretch">
                            <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Payloads Folder:" Width="120" />
                                    <TextBox Name="PayloadsPathTextBox" HorizontalAlignment="Stretch" Text="{Binding PayloadsPath, Mode=TwoWay}" />
                                    <Button Content="Browse" Name="BrowsePayloadsFolderButton" Command="{Binding BrowsePayloadsFolderCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Dumps Folder:" Width="120" />
                                    <TextBox Name="DumpsPathTextBox" HorizontalAlignment="Stretch" Text="{Binding DumpsPath, Mode=TwoWay}" />
                                    <Button Content="Browse" Name="BrowseDumpsFolderButton" Command="{Binding BrowseDumpsFolderCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Logs Folder:" Width="120" />
                                    <TextBox Name="LogsPathTextBox" HorizontalAlignment="Stretch" Text="{Binding LogsPath, Mode=TwoWay}" />
                                    <Button Content="Browse" Name="BrowseLogsFolderButton" Command="{Binding BrowseLogsFolderCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Extraction Folder:" Width="120" />
                                    <TextBox Name="ExtractionPathTextBox" HorizontalAlignment="Stretch" Text="{Binding ExtractionPath, Mode=TwoWay}" />
                                    <Button Content="Browse" Name="BrowseExtractionFolderButton" Command="{Binding BrowseExtractionFolderCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <Button Content="Save Settings" Name="SavePathsButton" Command="{Binding SavePathsCommand}" />
                                    <Button Content="Load Defaults" Name="LoadDefaultPathsButton" Command="{Binding LoadDefaultPathsCommand}" />
                                </StackPanel>
                            </StackPanel>
                            
                            <Border Grid.Row="1" Margin="0,16,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                        <TextBlock Text="Discovered Payloads:" FontWeight="Bold" />
                                        <TextBlock Text="{Binding DiscoveredPayloads.Count, StringFormat='({0} files)'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="Scanning..." IsVisible="{Binding IsScanning}" Foreground="Orange" />
                                    </StackPanel>
                                    <DataGrid Grid.Row="1" 
                                              Name="PayloadsDataGrid"
                                              ItemsSource="{Binding DiscoveredPayloads}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              GridLinesVisibility="Horizontal"
                                              HeadersVisibility="Column"
                                              MinHeight="150"
                                              MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="*" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat={}{0:N0} bytes}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Expander>
            <Expander Header="Memory &amp; Compare" IsExpanded="True" Name="MemCompareExpander" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <TabControl Margin="0,8,0,0">
                    <TabItem Header="Memory Dump">
                        <StackPanel Margin="12">
                            <Button Content="Load Profile" Command="{Binding LoadProfileCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <TextBlock Text="Select Region:" />
                            <ComboBox Name="RegionComboBox" ItemsSource="{Binding MemoryRegions}" SelectedItem="{Binding SelectedMemoryRegion, Mode=TwoWay}" DisplayMemberBinding="{Binding Name}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Address (hex):" />
                            <TextBox Name="DumpAddressTextBox" Text="{Binding DumpAddress, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Length (bytes):" />
                            <TextBox Name="DumpLengthTextBox" Text="{Binding DumpLength, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            
                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="8" Margin="0,8,0,8" IsVisible="{Binding IsDumpingMemory}">
                                <StackPanel>
                                    <TextBlock Text="Memory Dump Progress:" FontWeight="Bold" Margin="0,0,0,4" />
                                    <ProgressBar Name="DumpProgressBar" 
                                                 Value="{Binding DumpProgressPercentage}" 
                                                 Minimum="0" 
                                                 Maximum="100" 
                                                 HorizontalAlignment="Stretch" 
                                                 Height="20" />
                                    <TextBlock Name="DumpPercentLabel" 
                                               Text="{Binding DumpProgressPercentage, StringFormat={}{0:F1}%}" 
                                               HorizontalAlignment="Center" 
                                               Margin="0,2,0,0" />
                                    <TextBlock Name="DumpBytesLabel" 
                                               Text="{Binding DumpProgressBytes}" 
                                               HorizontalAlignment="Center" />
                                    <TextBlock Name="DumpTimeLabel" 
                                               Text="{Binding DumpProgressTime}" 
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                <Button Name="DumpMemoryButton" 
                                        Content="Dump Memory" 
                                        Command="{Binding DumpMemoryCommand}" 
                                        IsVisible="{Binding !IsDumpingMemory}"
                                        HorizontalAlignment="Stretch" />
                                <Button Name="CancelDumpButton" 
                                        Content="Cancel Dump" 
                                        Command="{Binding CancelDumpCommand}" 
                                        IsVisible="{Binding IsDumpingMemory}"
                                        Background="DarkRed"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Dump Comparison">
                        <TabControl>
                            <TabItem Header="Compare Folder">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Name="CompareFolderTextBox" Watermark="Select folder to compare..." HorizontalAlignment="Stretch" Text="{Binding CompareFolder, Mode=TwoWay}" />
                                        <Button Name="BrowseCompareFolderButton" Content="Browse" Command="{Binding BrowseCompareFolderCommand}" />
                                    </StackPanel>
                                    <Button Name="CompareDumpsButton" Content="Start Comparison" HorizontalAlignment="Stretch" Command="{Binding CompareDumpsCommand}" />
                                    <ListBox Name="ComparisonResultsListBox" Height="100" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Compare Files">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Name="CompareFile1TextBox" Watermark="Select file 1..." HorizontalAlignment="Stretch" Text="{Binding CompareFile1, Mode=TwoWay}" />
                                        <Button Name="BrowseCompareFile1Button" Content="Browse" Command="{Binding BrowseCompareFile1Command}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Name="CompareFile2TextBox" Watermark="Select file 2..." HorizontalAlignment="Stretch" Text="{Binding CompareFile2, Mode=TwoWay}" />
                                        <Button Name="BrowseCompareFile2Button" Content="Browse" Command="{Binding BrowseCompareFile2Command}" />
                                    </StackPanel>
                                    <Button Name="CompareTwoFilesButton" Content="Compare These Files" HorizontalAlignment="Stretch" Command="{Binding CompareTwoFilesCommand}" />
                                    <ListBox Name="FileCompareResultsListBox" Height="100" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
            </Expander>
            <Grid Grid.Row="2" Margin="0,8,0,0" Height="54" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Name="StartExploitSequenceButton" Content="Start Exploit Sequence" Grid.Column="0" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,0,8,0" Command="{Binding StartExploitSequenceCommand}" />
            </Grid>
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="8" BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*">
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Log Categories:" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" />
                        <CheckBox Name="FilterInfoCheckBox" IsChecked="{Binding Logging.FilterInfo, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[i]" Margin="0,0,5,0" />
                                <TextBlock Text="Info" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Name="FilterErrorCheckBox" IsChecked="{Binding Logging.FilterError, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[!]" Margin="0,0,5,0" />
                                <TextBlock Text="Error" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Name="FilterDebugCheckBox" IsChecked="{Binding Logging.FilterDebug, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[d]" Margin="0,0,5,0" />
                                <TextBlock Text="Debug" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Socat Log" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Name="ClearLogButton" Content="Clear Log" Width="110" Command="{Binding Logging.ClearLogCommand}"/>
                        <Button Name="ExportLogButton" Content="Export..." Width="110" Command="{Binding Logging.ExportLogCommand}"/>
                        <Button Name="ScrollToEndButton" Content="Scroll to End" Width="110" Command="{Binding Logging.ScrollToEndCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="ClearSocatLogButton" Content="Clear Log" Command="{Binding SocatLogging.ClearLogCommand}"/>
                        <Button Name="ExportSocatLogButton" Content="Export..." Command="{Binding SocatLogging.ExportLogCommand}"/>
                        <Button Name="SocatScrollToEndButton" Content="Scroll to End" Command="{Binding SocatLogging.ScrollToEndCommand}"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Grid.Column="0" RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Grid.Row="0" Text="Main Logger" FontWeight="DemiBold" FontSize="12" Margin="0,0,0,4" />
                        <ListBox Name="LogListBox" Grid.Row="1" ItemsSource="{Binding Logging.LogMessages}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" MinHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='[{0:yyyy-MM-dd HH:mm:ss}]'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Consolas,Monospace" />
                                        <TextBlock Text="{Binding Category, StringFormat='[{0}]'}" Foreground="{Binding Category, ConverterParameter=Color, Converter={StaticResource LogCategoryToColorConverter}}" FontWeight="Bold" FontFamily="Consolas,Monospace" />
                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Consolas,Monospace" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Row="2" Grid.Column="1" RowDefinitions="Auto,*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <TextBlock Grid.Row="0" Text="Socat Logger" FontWeight="DemiBold" FontSize="12" Margin="0,0,0,4" />
                        <ListBox Name="SocatLogListBox" Grid.Row="1" ItemsSource="{Binding SocatLogging.LogEntries}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" MinHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='[{0:yyyy-MM-dd HH:mm:ss}]'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Consolas,Monospace" />
                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Consolas,Monospace" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
