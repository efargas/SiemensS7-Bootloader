<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S7_Csharp_Utility.MainWindow"
        Title="S7 Bootloader Utility (Cross-Platform)"
        Width="900" Height="600"
        MinWidth="700" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File" />
            <MenuItem Header="Preferences" />
            <MenuItem Header="Tools">
                <MenuItem Header="Profile Management" Name="MenuProfileManagement" />
                <MenuItem Header="Firmware Unpacker" Name="MenuFirmwareUnpacker" />
            </MenuItem>
            <MenuItem Header="Help" />
        </Menu>
        <!-- LOGGING AREA AT VERY BOTTOM REMOVED; kept only the anchoring Grid version. -->

        <!-- BUTTON ROW (Only the in-Grid instance below is kept for correct layout) -->

        <!-- MAIN CONTENT ANCHORED GRID -->
        <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*">
            <Expander x:Name="ConfigExpander" Header="Configuration" IsExpanded="True" HorizontalAlignment="Stretch" VerticalAlignment="Top" Grid.Row="0">
                <TabControl HorizontalAlignment="Stretch">
                    <TabItem Header="Connection Parameters">
                        <Grid ColumnDefinitions="2*,2*" HorizontalAlignment="Stretch">
                            <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4" Padding="8" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="PLC Connection (Serial-to-TCP)" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="Host:" />
                                    <TextBox Name="PlcHostTextBox" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Port:" />
                                    <TextBox Name="PlcPortTextBox" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="4" Padding="8" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="Modbus Power Supply" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="IP Address:" />
                                    <TextBox Name="ModbusHostTextBox" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Port:" />
                                    <TextBox Name="ModbusPortTextBox" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Coil Addr:" />
                                    <TextBox Name="ModbusCoilTextBox" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Power-On Delay (s):" />
                                    <NumericUpDown Name="DelayNumericUpDown" Minimum="0" Maximum="120" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Folders &amp; Paths">
                        <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                <TextBlock Text="Payloads Folder:" Width="120" />
                                <TextBox Name="PayloadsPathTextBox" Width="210" HorizontalAlignment="Stretch" />
                                <Button Content="Browse" Name="BrowsePayloadsFolderButton" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                <TextBlock Text="Dumps Folder:" Width="120" />
                                <TextBox Name="DumpsPathTextBox" Width="210" HorizontalAlignment="Stretch" />
                                <Button Content="Browse" Name="BrowseDumpsFolderButton" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                <TextBlock Text="Logs Folder:" Width="120" />
                                <TextBox Name="LogsPathTextBox" Width="210" HorizontalAlignment="Stretch" />
                                <Button Content="Browse" Name="BrowseLogsFolderButton" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                                <TextBlock Text="Extraction Folder:" Width="120" />
                                <TextBox Name="ExtractionPathTextBox" Width="210" HorizontalAlignment="Stretch" />
                                <Button Content="Browse" Name="BrowseExtractionFolderButton" />
                            </StackPanel>
                            <Button Content="Save Settings" Name="SavePathsButton" Width="130" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Expander>
            <!-- Profile Management moved to its own window -->
            <Expander Header="Memory &amp; Compare" IsExpanded="True" Name="MemCompareExpander" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <TabControl Margin="0,8,0,0">
                    <TabItem Header="Memory Dump">
                        <StackPanel Margin="12">
                            <TextBlock Text="Select Region:" />
                            <ComboBox Name="RegionComboBox" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Address (hex):" />
                            <TextBox Name="DumpAddressTextBox" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Length (bytes):" />
                            <TextBox Name="DumpLengthTextBox" HorizontalAlignment="Stretch" />
                            <ProgressBar Name="DumpProgressBar" HorizontalAlignment="Stretch" />
                            <TextBlock Name="DumpPercentLabel" Text="0%" />
                            <TextBlock Name="DumpBytesLabel" Text="Read: 0 / 0 bytes" />
                            <TextBlock Name="DumpTimeLabel" Text="Elapsed: 0s | Remaining: 0s" />
                            <Button Name="DumpMemoryButton" Content="Dump Memory" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Dump Comparison">
                        <TabControl>
                            <TabItem Header="Compare Folder">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Name="CompareFolderTextBox" Watermark="Select folder to compare..." HorizontalAlignment="Stretch" />
                                        <Button Name="BrowseCompareFolderButton" Content="Browse" />
                                    </StackPanel>
                                    <Button Name="CompareDumpsButton" Content="Start Comparison" HorizontalAlignment="Stretch" />
                                    <ListBox Name="ComparisonResultsListBox" Height="100" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Compare Files">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Name="CompareFile1TextBox" Watermark="Select file 1..." HorizontalAlignment="Stretch" />
                                        <Button Name="BrowseCompareFile1Button" Content="Browse" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Name="CompareFile2TextBox" Watermark="Select file 2..." HorizontalAlignment="Stretch" />
                                        <Button Name="BrowseCompareFile2Button" Content="Browse" />
                                    </StackPanel>
                                    <Button Name="CompareTwoFilesButton" Content="Compare These Files" HorizontalAlignment="Stretch" />
                                    <ListBox Name="FileCompareResultsListBox" Height="100" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </TabItem>
                </TabControl>
            </Expander>
            <!-- Firmware Unpacker moved to its own window -->
            <Grid Grid.Row="2" Margin="0,8,0,0" Height="54" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Name="PowerOnButton" Content="Power ON" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,0,8,0" />
                <Button Name="PowerOffButton" Content="Power OFF" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,0,8,0" />
                <Button Name="UploadStagerButton" Content="Upload Stager" Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,0,8,0" />
            </Grid>
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="8" BorderBrush="#808080" BorderThickness="1" CornerRadius="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Log Categories:" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" />
                        <CheckBox Name="FilterInfoCheckBox" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[i]" Margin="0,0,5,0" />
                                <TextBlock Text="Info" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Name="FilterErrorCheckBox" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[!]" Margin="0,0,5,0" />
                                <TextBlock Text="Error" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Name="FilterDebugCheckBox" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[d]" Margin="0,0,5,0" />
                                <TextBlock Text="Debug" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="ClearLogButton" Content="Clear Log" Width="110"/>
                        <Button Name="ExportLogButton" Content="Export..." Width="110"/>
                        <Button Name="ScrollToEndButton" Content="Scroll to End" Width="110"/>
                    </StackPanel>
                    <ListBox Name="LogListBox"
                             Grid.Row="2"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Margin="0,8,0,0"
                             Background="#171A1F"
                             Foreground="#E3E6EB"
                             BorderBrush="#233A53"
                             BorderThickness="1"
                             FontFamily="Consolas,Monospace"
                             MinHeight="120"
                             SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='[{0:yyyy-MM-dd HH:mm:ss}]'}" Foreground="#6f94b2" />
                                    <TextBlock Text="{Binding Category}" FontWeight="Bold" Margin="6,0,6,0"/>
                                    <TextBlock Text="{Binding Message}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="2,0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
