<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Common Text Styles -->
    <Style Selector="TextBlock.HeaderText">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <Style Selector="TextBlock.SubHeaderText">
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    
    <Style Selector="TextBlock.StatusText">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Common Panel Styles -->
    <Style Selector="Border.InfoPanel">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    
    <Style Selector="Border.ContentPanel">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    
    <Style Selector="Border.ToolbarPanel"/>
    
    <Style Selector="Border.StatusPanel"/>

    <!-- Common Button Styles -->
    <Style Selector="Button.ActionButton">
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.ActionButton:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>
    
    <Style Selector="Button.ActionButton:pressed">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <!-- Dark Theme -->
    <Style Selector="Window">
        <Setter Property="Background" Value="#1A1A1A"/>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>

    <Style Selector="TextBlock.HeaderText">
        <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>

    <Style Selector="TextBlock.StatusText">
        <Setter Property="Foreground" Value="#A0AEC0"/>
    </Style>

    <Style Selector="TextBlock.LabelText">
        <Setter Property="Foreground" Value="#CBD5E0"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="Border.InfoPanel">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
    </Style>

    <Style Selector="Border.ContentPanel">
        <Setter Property="Background" Value="#1A202C"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
    </Style>

    <Style Selector="Border.ToolbarPanel">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
    </Style>

    <Style Selector="Border.StatusPanel">
        <Setter Property="Background" Value="#2A2A2A"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="#1A202C"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#374151"/>
        <Setter Property="VerticalGridLinesBrush" Value="#374151"/>
    </Style>

    <Style Selector="DataGrid DataGridColumnHeader">
        <Setter Property="Background" Value="#374151"/>
        <Setter Property="Foreground" Value="#F7FAFC"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style Selector="DataGrid DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>

    <Style Selector="DataGrid DataGridRow:selected">
        <Setter Property="Background" Value="#4C51BF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="DataGrid DataGridRow:pointerover">
        <Setter Property="Background" Value="#2D3748"/>
    </Style>

    <Style Selector="DataGrid DataGridCell">
        <Setter Property="BorderBrush" Value="#374151"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#4C51BF"/>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Opacity" Value="0.8"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
        <Setter Property="BorderBrush" Value="#4A5568"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="#4C51BF"/>
        <Setter Property="Background" Value="#374151"/>
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="#718096"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="#CBD5E0"/>
    </Style>

    <Style Selector="Expander">
        <Setter Property="Background" Value="#2D3748"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>

    <Style Selector="TabControl">
        <Setter Property="Background" Value="#2D3748"/>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Background" Value="#1A202C"/>
        <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="#4C51BF"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Menu">
        <Setter Property="Background" Value="#2D3748"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="#E2E8F0"/>
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="#4A5568"/>
    </Style>

    <!-- Light Theme -->
    <Style Selector="Window.Light">
        <Setter Property="Background" Value="#F8FAFC"/>
    </Style>

    <Style Selector=".Light TextBlock.HeaderText">
        <Setter Property="Foreground" Value="#1A202C"/>
    </Style>

    <Style Selector=".Light TextBlock.SubHeaderText">
        <Setter Property="Foreground" Value="#2D3748"/>
    </Style>

    <Style Selector=".Light TextBlock.StatusText">
        <Setter Property="Foreground" Value="#4A5568"/>
    </Style>

    <Style Selector=".Light Border.InfoPanel">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 #1A000000, 0 1 2 0 #0F000000"/>
    </Style>

    <Style Selector=".Light Border.ContentPanel">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="BoxShadow" Value="0 1 3 0 #1A000000"/>
    </Style>

    <Style Selector=".Light Border.ToolbarPanel">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector=".Light Border.StatusPanel">
        <Setter Property="Background" Value="#F9FAFB"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style Selector=".Light Button.RefreshButton">
        <Setter Property="Background" Value="#6366F1"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector=".Light Button.ExportButton">
        <Setter Property="Background" Value="#059669"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector=".Light ProgressBar.ModernProgress">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="#E5E7EB"/>
        <Setter Property="Foreground" Value="#3B82F6"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    
    <Style Selector=".Light TextBlock.StatusIdentical">
        <Setter Property="Foreground" Value="#059669"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector=".Light TextBlock.StatusDifferent">
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector=".Light TextBlock.StatusProgress">
        <Setter Property="Foreground" Value="#7C3AED"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
</Styles>