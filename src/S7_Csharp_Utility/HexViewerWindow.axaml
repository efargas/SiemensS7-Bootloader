<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S7_Csharp_Utility.HexViewerWindow"
        Title="Hex Viewer"
        Width="800"
        Height="600"
        MinWidth="600"
        MinHeight="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#f0f0f0" Padding="10">
            <TextBlock x:Name="FilePathText" FontWeight="Bold" Text="File: "/>
        </Border>
        
        <!-- Hex Content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="HexContent" 
                       FontFamily="Consolas,Monaco,monospace" 
                       FontSize="12" 
                       Margin="10"
                       Background="White"
                       Foreground="Black"
                       TextWrapping="NoWrap"/>
        </ScrollViewer>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#f0f0f0" Padding="5">
            <TextBlock x:Name="StatusText" Text="Ready"/>
        </Border>
    </Grid>
</Window>