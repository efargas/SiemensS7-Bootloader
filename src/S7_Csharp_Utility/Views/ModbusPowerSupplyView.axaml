<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="S7_Csharp_Utility.Views.ModbusPowerSupplyView">
    <Border Classes="InfoPanel" Padding="8" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="Modbus Power Supply" Classes="HeaderText" Margin="0,0,0,8" />
            <TextBlock Text="IP Address:" Classes="LabelText"/>
            <StackPanel>
                <TextBox Name="ModbusHostTextBox" 
                         Text="{Binding ModbusHost, Mode=TwoWay}" 
                         HorizontalAlignment="Stretch"
                         Watermark="Enter IP address or hostname" />
                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ModbusHostTextBox}"
                           Foreground="Red"
                           FontSize="11"
                           Margin="0,2,0,0"
                           IsVisible="{Binding (Validation.HasErrors), ElementName=ModbusHostTextBox}" />
            </StackPanel>
            <TextBlock Text="Port:" Classes="LabelText"/>
            <StackPanel>
                <NumericUpDown Name="ModbusPortNumeric" 
                               Minimum="1" Maximum="65535" 
                               Value="{Binding ModbusPort, Mode=TwoWay}" 
                               HorizontalAlignment="Stretch"
                               Watermark="Enter port number (1-65535)" />
                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ModbusPortNumeric}"
                           Foreground="Red"
                           FontSize="11"
                           Margin="0,2,0,0"
                           IsVisible="{Binding (Validation.HasErrors), ElementName=ModbusPortNumeric}" />
            </StackPanel>
            <TextBlock Text="Coil Addr:" Classes="LabelText"/>
            <StackPanel>
                <NumericUpDown Name="ModbusCoilNumeric" 
                               Minimum="1" Maximum="65535" 
                               Value="{Binding ModbusCoil, Mode=TwoWay}" 
                               HorizontalAlignment="Stretch"
                               Watermark="Enter coil address (1-65535)" />
                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ModbusCoilNumeric}"
                           Foreground="Red"
                           FontSize="11"
                           Margin="0,2,0,0"
                           IsVisible="{Binding (Validation.HasErrors), ElementName=ModbusCoilNumeric}" />
            </StackPanel>
            <TextBlock Text="Slave ID:" Classes="LabelText"/>
            <StackPanel>
                <NumericUpDown Name="ModbusSlaveIdNumeric" 
                               Minimum="0" Maximum="255" 
                               Value="{Binding ModbusSlaveId, Mode=TwoWay}" 
                               HorizontalAlignment="Stretch"
                               Watermark="Enter slave ID (0-255)" />
                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ModbusSlaveIdNumeric}"
                           Foreground="Red"
                           FontSize="11"
                           Margin="0,2,0,0"
                           IsVisible="{Binding (Validation.HasErrors), ElementName=ModbusSlaveIdNumeric}" />
            </StackPanel>
            <TextBlock Text="Power-On Delay (s):" Classes="LabelText"/>
            <StackPanel>
                <NumericUpDown Name="DelaySecondsNumeric" 
                               Minimum="0" Maximum="300" 
                               Value="{Binding DelaySeconds, Mode=TwoWay}" 
                               HorizontalAlignment="Stretch"
                               Watermark="Enter delay in seconds (0-300)" />
                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=DelaySecondsNumeric}"
                           Foreground="Red"
                           FontSize="11"
                           Margin="0,2,0,0"
                           IsVisible="{Binding (Validation.HasErrors), ElementName=DelaySecondsNumeric}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Content="Connect" Command="{Binding ConnectModbusCommand}"/>
                <Button Content="Disconnect" Command="{Binding DisconnectModbusCommand}"/>
                <TextBlock Text="{Binding ModbusStatus}" VerticalAlignment="Center" Classes="StatusText"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Content="Power ON" Command="{Binding PowerOnCommand}" Background="Green" Foreground="White"/>
                <Button Content="Power OFF" Command="{Binding PowerOffCommand}" Background="Red" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
