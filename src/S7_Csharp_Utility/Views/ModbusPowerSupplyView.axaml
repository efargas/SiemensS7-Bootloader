<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="S7_Csharp_Utility.Views.ModbusPowerSupplyView">
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Text="Modbus Power Supply" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="IP Address:" />
            <TextBox Text="{Binding ModbusHost, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Port:" />
            <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding ModbusPort, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Coil Addr:" />
            <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding ModbusCoil, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Slave ID:" />
            <NumericUpDown Minimum="0" Maximum="255" Value="{Binding ModbusSlaveId, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Power-On Delay (s):" />
            <NumericUpDown Minimum="0" Maximum="120" Value="{Binding DelaySeconds, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <Button Content="Connect" Command="{Binding ConnectModbusCommand}"/>
                <Button Content="Disconnect" Command="{Binding DisconnectModbusCommand}"/>
                <TextBlock Text="{Binding ModbusStatus}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
