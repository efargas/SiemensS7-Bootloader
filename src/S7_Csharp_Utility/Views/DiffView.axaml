<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="S7_Csharp_Utility.Views.DiffView"
        Title="Binary Diff">
    <Grid ColumnDefinitions="*,5,*">
        <TextBox Grid.Column="0" Text="{Binding File1Text}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Monospace"/>
        <GridSplitter Grid.Column="1" />
        <TextBox Grid.Column="2" Text="{Binding File2Text}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Monospace"/>
    </Grid>
</Window>
