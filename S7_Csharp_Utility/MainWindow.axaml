<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S7_Csharp_Utility.MainWindow"
        Title="S7 Bootloader Utility (Cross-Platform)"
        Width="450" Height="400"
        CanResize="False">

  <Grid Margin="10" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">

    <!-- Settings Panels -->
    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="10">

      <!-- PLC Connection -->
      <Border Classes="group-box">
        <StackPanel Spacing="5">
          <TextBlock Text="PLC Connection (Serial-to-TCP)" FontWeight="Bold"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="5">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="PlcHostTextBox" Text="localhost"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="PlcPortTextBox" Text="10001"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Modbus Power Supply -->
      <Border Classes="group-box">
        <StackPanel Spacing="5">
          <TextBlock Text="Modbus Power Supply" FontWeight="Bold"/>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="5">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP Address:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="ModbusHostTextBox" Text="192.168.1.123"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="ModbusPortTextBox" Text="502"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Coil Addr:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="ModbusCoilTextBox" Text="1"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Power-On Delay (s):" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" Name="DelayNumericUpDown" Value="1" Minimum="0" Maximum="120"/>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- Action Buttons -->
    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5" Margin="10,0,0,0">
      <Button Name="PowerOnButton" Content="Power ON" Width="130"/>
      <Button Name="PowerOffButton" Content="Power OFF" Width="130"/>
      <Button Name="UploadStagerButton" Content="Upload Stager" FontWeight="Bold" Width="130" Height="150"/>
    </StackPanel>

    <!-- Log Viewer -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
      <TextBlock Name="LogTextBlock" TextWrapping="Wrap" FontFamily="Monospace"/>
    </ScrollViewer>

  </Grid>
</Window>
