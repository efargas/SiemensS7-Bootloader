# =============================================================================
# .NET Build Artifacts and IDE Files
# =============================================================================

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# =============================================================================
# .NET Build Output - IGNORE ALL
# =============================================================================

# Build directories - ignore obj/ completely, bin/ selectively
**/obj/

# Build artifacts in bin/ directories (but allow exceptions below)
**/bin/**/*.dll
**/bin/**/*.exe
**/bin/**/*.pdb
**/bin/**/*.cache
**/bin/**/*.deps.json
**/bin/**/*.runtimeconfig.json
**/bin/**/*.runtimeconfig.dev.json
**/bin/**/*.xml
**/bin/**/*.config
**/bin/**/*.manifest
**/bin/**/*.application
**/bin/**/*.deploy
**/bin/**/*.mdb
**/bin/**/*.vshost.*
**/bin/**/*.lastcodeanalysissucceeded
**/bin/**/runtimes/
**/bin/**/S7_CS_Utility
**/bin/**/CoverletSourceRootsMapping_*

# NuGet packages
*.nupkg
*.snupkg
packages/
!packages/build/
!packages/repositories.config

# =============================================================================
# Test Results and Coverage
# =============================================================================

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
*.testlog

# Coverage reports
coverage/
*.lcov
opencover.xml

# =============================================================================
# EXCEPTIONS - Keep These Specific Artifacts
# =============================================================================

# Keep compiled payload .bin files in source Resources (not build output)
!src/Resources/payloads/**/*.bin
!src/S7_Csharp_Utility/Resources/**/*.bin
!bootloader-payloads/**/*.bin

# Keep C# Utility logs and settings from build output
!src/S7_Csharp_Utility/bin/
!src/S7_Csharp_Utility/bin/**/
!src/S7_Csharp_Utility/bin/**/logs/
!src/S7_Csharp_Utility/bin/**/logs/**
!src/S7_Csharp_Utility/bin/**/Resources/
!src/S7_Csharp_Utility/bin/**/Resources/logs/
!src/S7_Csharp_Utility/bin/**/Resources/logs/**
!src/S7_Csharp_Utility/bin/**/Resources/Settings/
!src/S7_Csharp_Utility/bin/**/Resources/Settings/**
!src/S7_Csharp_Utility/bin/**/Resources/dumps/
!src/S7_Csharp_Utility/bin/**/Resources/dumps/**
!src/S7_Csharp_Utility/bin/**/Resources/extracted/
!src/S7_Csharp_Utility/bin/**/Resources/extracted/**

# Keep payload .bin files in build output (these are copied resources)
!src/S7_Csharp_Utility/bin/**/Resources/payloads/
!src/S7_Csharp_Utility/bin/**/Resources/payloads/**/*.bin
!tests/S7_Csharp_Utility.Tests/bin/**/Resources/payloads/
!tests/S7_Csharp_Utility.Tests/bin/**/Resources/payloads/**/*.bin

