// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET)",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers/features/dotnet:2": {},
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers/features/sshd:1": {},
		"ghcr.io/jungaretti/features/make:1": {},
		"ghcr.io/jckimble/devcontainer-features/ngrok:3": {},
		"ghcr.io/devcontainers-extra/features/actions-runner:1": {},
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {},
		"ghcr.io/devcontainers-extra/features/git-lfs:1": {},
		"ghcr.io/devcontainers-extra/features/nmap-apt-get:1": {},
		"ghcr.io/devcontainers-extra/features/poppler-utils-apt-get:1": {},
		"ghcr.io/thediveo/devcontainer-features/docsify:0": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"LegendTheDeveloper.avalonia-document-outline"
			]
		}
	}

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [5000, 5001],
	// "portsAttributes": {
	//		"5001": {
	//			"protocol": "https"
	//		}
	// }

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "dotnet restore",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
